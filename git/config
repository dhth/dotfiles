# Resources
# - https://micahkepe.com/blog/gitconfig/

[include]
    path = ~/.config/git/preferences
[user]
	name = Dhruv Thakur
	email = dhruvt93@gmail.com
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[core]
	editor = nvim
	excludesfile = ~/.gitignore
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    line-numbers = true
    syntax-theme = none
    true-color = always
    tabs = 4
    side-by-side = true
    ; diff-so-fancy = true
    ; diff-highlight = true

    file-added-label = [●]
    file-copied-label = [C]
    file-modified-label = [+]
    file-removed-label = [⛌]
    file-renamed-label = [→]
    features = gruvbox-dark-hard
[include]
    path = ~/.config/git/themes/gruvbox-dark-hard.gitconfig
[include]
    path = ~/.config/git/themes/gruvbox-light-hard.gitconfig
[split-diffs]
	min-line-width = 0
	theme-name = light
[commit]
	gpgsign = true
[fetch]
	prunetags = true
[maintenance]
    auto = true
    strategy = incremental
[coderabbit]
	machineId = cli/56473f7d74464632ab9dbcac64931ddc
[drift]
	theme = gruvbox-dark
