[push]
	default = simple
	autosetupremote = true
[pull]
	ff = only
	default = current
[init]
	defaultBranch = main
[alias]
    l = log  \
        --color \
        --graph \
        --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' \
        --abbrev-commit
    la = l  \
        --all
    lnb = l \
        --perl-regexp --author='^(?!.*dependabot\\[bot\\])'
	d = diff
	f = fetch
	ds = diff --staged
	p = pull
	c = clone
	cb = checkout -b
	cp = cherry-pick
	ms = merge --squash
	s = status -sb
	sh = show HEAD
	rb = rebase origin/main
	rbi = rebase -i origin/main
[core]
	whitespace = trailing-space
[color]
	ui = true
[diff]
	renames = copies
	colorMoved = default
	algorithm = histogram
	context = 10
[help]
	autocorrect = prompt
[merge]
	log = true
	conflictStyle = zdiff3
[rebase]
	autostash = true
[commit]
	verbose = true
[branch]
	sort = -committerdate
[tag]
	sort = -version:refname
[fetch]
	prune = true
