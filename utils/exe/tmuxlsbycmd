#!/usr/bin/env bash

set -euo pipefail

if [ "$#" -gt 1 ]; then
    echo "Usage: $(basename "$0") [running-command]" >&2
    exit 1
fi

# Use untruncated fields; pane IDs are unique across sessions within a tmux server.
panes=$(tmux list-panes -a -F $'#{pane_id}\t#{pane_current_command}')
if [ "$#" -eq 1 ]; then
    command=$1
else
    commands=$(printf '%s\n' "$panes" | cut -f2 | sort -u)
    command=$(printf '%s\n' "$commands" | fzf --height=10 --layout=reverse) || {
        status=$?
        case "$status" in
        1 | 130) exit 0 ;;
        *) exit "$status" ;;
        esac
    }

    [ -n "$command" ] || exit 0
fi

matches=$(printf '%s\n' "$panes" | awk -F '\t' -v command="$command" '$2 == command {print $1}')
if [ -z "$matches" ]; then
    echo "Error: No panes found running '$command'." >&2
    exit 1
fi

printf '%s\n' "$matches"
