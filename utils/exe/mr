#!/usr/bin/env bash

while true; do
    tasks=$(mise tasks ls --all --json | jq -r '.[].name') || exit $?

    task=$(printf '%s\n' "$tasks" | awk 'NF { print $1 }' | fzf --layout=reverse --style=minimal)
    exit_code=$?

    # Treat cancelling the fzf picker as a clean exit.
    if [[ $exit_code -eq 130 ]]; then
        exit 0
    fi

    mise run "$task"
done
