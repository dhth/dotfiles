#!/usr/bin/env bash

set -euo pipefail

title_filter='#{m|ri:^(cl|cx|oc|am|ag2)([[:space:]]*\||$),#{pane_title}}'
window_filter='#{m|ri:^(cl|cx|oc|am|ag2)$,#{window_name}}'
command_filter='#{&&:#{&&:#{!=:#{pane_current_command},bash},#{!=:#{pane_current_command},zsh}},#{&&:#{!=:#{pane_current_command},fish},#{!=:#{pane_current_command},sh}}}'

pane_rows=$(
    tmux list-panes -a -f "#{&&:#{||:${title_filter},${window_filter}},${command_filter}}" -F '#{pane_id}	#{session_name}	#{pane_title}	#{window_activity}' |
        sort -t $'\t' -k4,4nr |
        awk -F '\t' '
            {
                title = $3
                task = ""
                separator = index(title, "|")
                if (separator) {
                    task = substr(title, separator + 1)
                }
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", task)
                printf "%s\t%-30.30s%s\n", $1, $2, (task == "" ? "" : "  " task)
            }
        '
)

if [ -z "$pane_rows" ]; then
    exit 0
fi

selected=$(
    printf '%s\n' "$pane_rows" |
        fzf \
            --reverse \
            --style=minimal \
            --no-info \
            --no-sort \
            --delimiter '\t' \
            --with-nth=2
) || {
    status=$?
    case "$status" in
    1 | 130) exit 0 ;;
    *) exit "$status" ;;
    esac
}

[ -n "$selected" ] || exit 0

pane_target=${selected%%$'\t'*}
tmux switch-client -t "$pane_target"
