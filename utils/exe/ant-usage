#!/usr/bin/env bash

set +x
set -euo pipefail

usage() {
    printf 'Usage: %s [--json | --help]\n\n' "${0##*/}"
    printf 'Show an Anthropic usage dashboard, or the original response with --json.\n'
}

mode=dashboard
if (($# > 1)); then
    usage >&2
    exit 1
fi
case "${1:-}" in
'') ;;
--json) mode=json ;;
--help | -h)
    usage
    exit 0
    ;;
*)
    usage >&2
    exit 1
    ;;
esac

if ! access_token=$(security find-generic-password -s 'Claude Code-credentials' -w 2>/dev/null |
    jq -er '.claudeAiOauth.accessToken | select(type == "string" and length > 0)' 2>/dev/null); then
    printf "Unable to read Claude Code's access token from Keychain.\n" >&2
    printf 'Allow Keychain access when prompted, or sign in to Claude Code.\n' >&2
    exit 1
fi

# Pass the header through stdin so the token is not exposed in process arguments.
response=$(printf 'Authorization: Bearer %s\n' "$access_token" |
    curl -sS --fail --connect-timeout 10 --max-time 30 \
        'https://api.anthropic.com/api/oauth/usage' \
        -H @- \
        -H 'anthropic-beta: oauth-2025-04-20' \
        -H 'Accept: application/json' \
        --user-agent 'dotfiles-ant-usage/1.0')
unset access_token

if [[ "$mode" == json ]]; then
    jq . <<<"$response"
    exit 0
fi

jq -r '
    def duration:
        ([., 0] | max | floor) as $seconds
        | [
            (if $seconds >= 86400 then "\($seconds / 86400 | floor)d" else empty end),
            (if ($seconds % 86400 / 3600 | floor) > 0
             then "\($seconds % 86400 / 3600 | floor)h" else empty end),
            (if ($seconds % 3600 / 60 | floor) > 0
             then "\($seconds % 3600 / 60 | floor)m" else empty end)
        ]
        | if length == 0 then "<1m" else join(" ") end;

    def humanize:
        gsub("_"; " ") | (.[0:1] | ascii_upcase) + .[1:];

    def limit_name:
        if . == "session" then "5-hour"
        elif . == "weekly_all" then "Weekly"
        elif startswith("weekly_") then "Weekly · \(ltrimstr("weekly_") | humanize)"
        else humanize
        end;

    def limits:
        if (.limits // [] | length) > 0 then .limits
        else [
            to_entries[]
            | select(.key == "five_hour" or (.key | startswith("seven_day")))
            | select(.value != null)
            | {
                kind: (if .key == "five_hour" then "session"
                       elif .key == "seven_day" then "weekly_all"
                       else .key | sub("^seven_day_"; "weekly_") end),
                percent: .value.utilization,
                resets_at: .value.resets_at
            }
        ]
        end;

    def bar:
        ([., 0] | max | [., 100] | min | . / 5 | floor) as $filled
        | ("█" * $filled) + ("░" * (20 - $filled));

    def usage_summary:
        if (.percent | type) == "number" then
            "\(.percent | bar)  \(.percent)% used"
        else "Usage unknown"
        end;

    def reset_summary:
        if .resets_at == null then "No reset time reported"
        else
            (try (.resets_at | sub("\\.[0-9]+"; "")
                  | sub("\\+00:00$"; "Z") | fromdateiso8601) catch null) as $reset
            | if $reset == null then "Reset time unknown"
              elif $reset <= now then "Reset time has passed"
              else "Resets in \($reset - now | duration)"
              end
        end;

    def window:
        (.kind // "unknown" | limit_name) as $name
        | (.scope.model.display_name // .scope.surface // "") as $scope
        | "\($name)\(if $scope == "" then "" else " · \($scope)" end)  \(usage_summary)",
          ("  \(reset_summary)"
           + (if (.percent | type) == "number" and .percent >= 100 then " · LIMIT REACHED"
              elif .severity != null and .severity != "normal"
              then " · \(.severity | humanize)" else "" end)),
          "";

    def extra_usage:
        (if (.spend.enabled | type) == "boolean" then .spend.enabled
         else .extra_usage.is_enabled end) as $enabled
        | (.spend.disabled_reason // .extra_usage.disabled_reason) as $reason
        | if $enabled == true then
            "Extra usage enabled"
            + (if (.extra_usage.utilization | type) == "number"
               then " · \(.extra_usage.utilization)% used" else "" end)
          elif $enabled == false then
            "Extra usage disabled"
            + (if $reason == null then "" else " · \($reason | humanize)" end)
          else empty
          end;

    "Anthropic",
    "",
    (limits | if length == 0 then "No usage limits reported", ""
              else .[] | window end),
    extra_usage
' <<<"$response"
